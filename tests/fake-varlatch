#!/usr/bin/env bash
# A stand-in for the varlatch CLI, for tests/run.sh. Every call is recorded
# in $HOME/calls.log. `status` prints $HOME/status.json (no sessions when it
# is missing), and the FAKE_* variables choose how sign-ins end.
echo "cli $*" >> "$HOME/calls.log"
case "${1:-}" in
  --version) echo "varlatch ${FAKE_VERSION:-0.15.0} (migration 26)"; exit 0 ;;
  --help) echo "Usage: varlatch <command>"; exit 0 ;;
  status) cat "$HOME/status.json" 2>/dev/null || echo '{"version":1,"servers":[],"repo":null}'; exit 0 ;;
  logout) echo "Logged out."; exit 0 ;;
  login) ;;
  *) exit 64 ;;
esac

mode="browser"
for arg in "$@"; do
  case "$arg" in --start) mode="start" ;; --wait) mode="wait" ;; esac
done

case "$mode" in
  start)
    if [ -n "${FAKE_START_FAIL:-}" ]; then
      echo "varlatch login: the server refused to start a sign-in (NOT_FOUND)" >&2
      exit 1
    fi
    echo '{"verificationUri":"https://vl.example.com/device","userCode":"BCDF-GHJK","expiresAt":"2099-01-01T00:10:00.000Z"}'
    ;;
  wait)
    # FAKE_WAIT: approve | pending-once | deny | expire | hang
    n=$(cat "$HOME/wait-count" 2>/dev/null || echo 0)
    n=$((n + 1)); echo "$n" > "$HOME/wait-count"
    case "${FAKE_WAIT:-approve}" in
      approve) ;;
      pending-once)
        if [ "$n" -eq 1 ]; then
          sleep 1
          echo '{"state":"pending"}'
          echo "varlatch login: not approved yet." >&2
          exit 75
        fi ;;
      deny) echo '{"state":"denied"}'; echo "varlatch login: the sign-in was denied." >&2; exit 77 ;;
      expire) echo '{"state":"expired"}'; echo "varlatch login: the sign-in expired." >&2; exit 77 ;;
      hang) sleep 60; exit 75 ;;
    esac
    echo '{"state":"signed-in","credentialId":"crd_test","expiresAt":"2099-01-01T12:00:00Z"}'
    ;;
  browser)
    echo "Open this address to sign in: https://vl.example.com/enroll?state=test"
    sleep "${FAKE_LOGIN_SLEEP:-0}"
    if [ "${FAKE_LOGIN_RC:-0}" -ne 0 ]; then
      echo "varlatch login: browser sign-in failed: no passkey" >&2
      exit "$FAKE_LOGIN_RC"
    fi
    echo "Issued CLI credential (expires 2099-01-01T12:00:00Z)."
    ;;
esac
