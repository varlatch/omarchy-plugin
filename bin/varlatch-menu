#!/usr/bin/env bash
# Menu actions for the Varlatch omarchy plugin. Every read goes through
# `varlatch status --json` (offline); the only network actions are the ones
# the user explicitly clicks (login, logout, verify, update) and, with the
# widget's checkUpdates setting on, a release check at most twice a day.
set -euo pipefail

SHELL_JSON="$HOME/.config/omarchy/shell.json"

# Honor a varlatchCommand override configured on the bar widget.
varlatch_cmd() {
  local override=""
  if [ -f "$SHELL_JSON" ]; then
    override=$(jq -r '[.bar.layout[]?[]? | select(.id == "varlatch") | .varlatchCommand] | map(select(. != null)) | first // empty' "$SHELL_JSON" 2>/dev/null || true)
  fi
  echo "${override:-varlatch}"
}

# A widget setting from shell.json, or the given default.
widget_setting() {
  local value=""
  if [ -f "$SHELL_JSON" ]; then
    value=$(jq -r --arg k "$1" '[.bar.layout[]?[]? | select(.id == "varlatch") | .[$k]] | map(select(. != null)) | first // empty | tostring' "$SHELL_JSON" 2>/dev/null || true)
  fi
  echo "${value:-$2}"
}

CMD=$(varlatch_cmd)
STATE_DIR="$HOME/.local/state/varlatch-omarchy"
STATE_FILE="$STATE_DIR/servers.json"
LOGIN_FILE="$STATE_DIR/login.json"
UPDATE_FILE="$STATE_DIR/update.json"
RELEASE_REPO="${VARLATCH_RELEASE_REPO:-varlatch/varlatch}"
# Seconds between release checks in the background. However stale, the
# release check runs at most once an hour, so a failed one retries an hour
# later.
UPDATE_TTL=43200
UPDATE_MIN_GAP=3600

boot_id() { cat /proc/sys/kernel/random/boot_id 2>/dev/null || true; }

# A browser sign-in started by `login` is still waiting on its callback.
# The boot id keeps a process id from before a reboot from matching
# whatever process has it now.
login_running() {
  local pid boot
  pid=$(jq -r 'select(.state == "pending") | .pid // empty' "$LOGIN_FILE" 2>/dev/null || true)
  boot=$(jq -r 'select(.state == "pending") | .boot // empty' "$LOGIN_FILE" 2>/dev/null || true)
  [ -n "$pid" ] && { [ -z "$boot" ] || [ "$boot" = "$(boot_id)" ]; } && kill -0 "$pid" 2>/dev/null
}

# Replace a state file with stdin in one rename: the widget reloads these
# files the moment they change and must never read one half-written.
write_state() {
  local tmp
  tmp=$(mktemp "$1.XXXXXX") || return 1
  # Nothing on stdin means the writer failed: keep the old file.
  if cat > "$tmp" && [ -s "$tmp" ] && mv -f "$tmp" "$1"; then return 0; fi
  rm -f "$tmp"; return 1
}

login_idle() { mkdir -p "$STATE_DIR"; echo '{"state":"idle"}' | write_state "$LOGIN_FILE"; }

# "https://varlatch.example.com" from what a person typed: trimmed,
# https:// when no scheme is given, no trailing slash.
normalize_server() {
  local s
  s=$(printf '%s' "$1" | tr -d '[:space:]')
  s=${s%/}
  [ -z "$s" ] && return 0
  [[ "$s" =~ ^[a-zA-Z][a-zA-Z0-9+.-]*:// ]] || s="https://$s"
  echo "$s"
}

# Add a server to the ones "Log in" falls back to after a full logout.
remember_server() {
  mkdir -p "$STATE_DIR"
  local known="[]"
  [ -f "$STATE_FILE" ] && known=$(jq -c 'if type == "array" then . else [] end' "$STATE_FILE" 2>/dev/null || echo "[]")
  jq -cn --arg s "$1" --argjson known "$known" '[$s] + ($known - [$s])' | write_state "$STATE_FILE"
}

status_json() { eval "$CMD status --json" 2>/dev/null; }

# Localhost dev servers are hidden unless the widget's showLocalhost
# setting turns them on; either way a real deployment is preferred.
show_localhost() { [ "$(widget_setting showLocalhost off)" = "on" ]; }
if show_localhost; then
  prefer_live='sort_by(if test("^[a-z]+://(localhost|127\\.)") then 1 else 0 end) | first // empty'
else
  prefer_live='map(select(test("^[a-z]+://(localhost|127\\.)") | not)) | first // empty'
fi

# Currently stored server, live one first.
first_server() { status_json | jq -r ".servers | map(.server) | $prefer_live"; }

# Login target even after a full logout: current store, then the servers we
# last saw (sync-menu remembers them), then the environment.
login_server() {
  local s
  s=$(first_server)
  [ -z "$s" ] && [ -f "$STATE_FILE" ] && s=$(jq -r "$prefer_live" "$STATE_FILE" 2>/dev/null || true)
  [ -z "$s" ] && s="${VARLATCH_SERVER:-}"
  echo "$s"
}

refresh_widget() { omarchy-shell varlatch refresh >/dev/null 2>&1 || true; }

notify() { notify-send -a Varlatch "Varlatch" "$1"; }

# "0.10.1" from `varlatch 0.10.1 (migration 20)`, "0.50.0" from
# `varlatch 0.50.0`; empty when the CLI is missing or predates --version.
run_cli() {
  if [ -x "$CMD" ] && [ ! -d "$CMD" ]; then
    "$CMD" "$@"
  else
    eval "$CMD $(printf '%q ' "$@")"
  fi
}
cli_version() { run_cli --version 2>/dev/null | parse_version || true; }
parse_version() {
  local raw
  raw=$(sed -nE '1s/^varlatch ([0-9][^ ]*).*/\1/p')
  clean_version "$raw" 2>/dev/null || true
}

# Strict version token validator (bounded length, no shell metacharacters).
# Applied to GitHub release tags, server /v1/meta, cached update.json on read,
# and user/IPC version arguments before anything is cached, shown, or run.
valid_version() {
  local v=${1:-}
  [ "${#v}" -gt 0 ] && [ "${#v}" -le 64 ] && [[ "$v" =~ ^v?[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.]+)?$ ]]
}
clean_version() {
  local v=${1:-}
  valid_version "$v" || return 1
  printf '%s\n' "${v#v}"
}
shell_quote() { printf "'%s'" "${1//\'/\'\\\'\'}"; }

# True when $1 is owned by root (uid 0) and not group- or other-writable.
is_root_safe() {
  local p=$1 info uid mode
  [ -e "$p" ] || return 1
  info=$(stat -c '%u %a' "$p" 2>/dev/null) || return 1
  uid=${info%% *}; mode=${info#* }
  [ "$uid" = "0" ] && [ $((8#$mode & 8#022)) -eq 0 ]
}

# A file is the TypeScript CLI's single-file build (varlatch-cli-X.cjs, up to
# 0.23): its banner is in its first lines. From 0.50 the CLI is a native
# program.
is_typescript() { head -c 512 "$1" 2>/dev/null | grep -aq 'Varlatch CLI'; }
is_native() { [ "$(head -c 4 "$1" 2>/dev/null | tail -c 3 | tr -d '\0')" = ELF ]; }

# Legacy Homebrew wrapper marker: only checked in "#!" script files so a
# compiled native binary's own error strings never trigger it.
has_homebrew_marker() {
  local f=$1
  [ -f "$f" ] || return 1
  [ "$(head -c 2 "$f" 2>/dev/null || true)" = "#!" ] || return 1
  head -c 512 "$f" 2>/dev/null | grep -aq 'installed with Homebrew'
}

# True when $1 (as given, or symlink-resolved) belongs to Homebrew, or carries
# Homebrew's legacy wrapper marker (in a "#!" file).
is_homebrew() {
  local entry=$1 real=""
  [ -e "$entry" ] || [ -L "$entry" ] || return 1
  real=$(readlink -f "$entry" 2>/dev/null || echo "$entry")
  case "$entry" in
    /home/linuxbrew/.linuxbrew/* | /opt/homebrew/* | /usr/local/Homebrew/* | /usr/local/Cellar/* | */Cellar/*) return 0 ;;
  esac
  case "$real" in
    /home/linuxbrew/.linuxbrew/* | /opt/homebrew/* | /usr/local/Homebrew/* | /usr/local/Cellar/* | */Cellar/*) return 0 ;;
  esac
  has_homebrew_marker "$entry" && return 0
  [ "$real" != "$entry" ] && has_homebrew_marker "$real" && return 0
  return 1
}

# How the CLI is installed, which decides whether we may replace it:
#   release <path>   a release's CLI: native, or the single-file build
#   homebrew <path>  Homebrew's file: update with brew
#   checkout <path>  a build inside a source checkout: update with git
#   custom           a varlatchCommand with arguments, or unrecognized
#   missing          not on PATH
cli_install() {
  local path real version
  # Existing literal path first, so paths containing spaces are supported.
  if [ -x "$CMD" ] && [ ! -d "$CMD" ]; then
    path=$CMD
  else
    case "$CMD" in *[[:space:]]*) echo custom; return ;; esac
    path=$(command -v "$CMD" 2>/dev/null) || { echo missing; return; }
  fi
  if is_homebrew "$path"; then echo "homebrew $path"; return; fi
  real=$(readlink -f "$path")
  if git -C "$(dirname "$real")" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "checkout $real"
  elif is_typescript "$real"; then
    echo "release $path"
  elif is_native "$real"; then
    # A development build says so in its version, and has no self-update.
    version=$(cli_version)
    case "$version" in "" | *-dev) echo custom ;; *) echo "release $path" ;; esac
  else
    echo custom
  fi
}

# Latest published release, without the "v". An anonymous request.
latest_release() {
  local tag=""
  tag=$(curl -fsS --max-time 10 -H 'Accept: application/vnd.github+json' \
    "https://api.github.com/repos/$RELEASE_REPO/releases/latest" 2>/dev/null | jq -r '.tag_name // empty' 2>/dev/null) || tag=""
  clean_version "$tag" 2>/dev/null || true
}

# True when version $1 is newer than $2. `sort -V` puts a "~" suffix before
# the bare version, as a prerelease (0.50.0-rc.3) comes before its release.
version_gt() {
  local a=${1/-/\~} b=${2/-/\~}
  [ "$a" != "$b" ] && [ "$(printf '%s\n%s\n' "$a" "$b" | sort -V | tail -n1)" = "$a" ]
}

release_url() { echo "https://github.com/$RELEASE_REPO/releases/tag/v$1"; }

refresh_version() { omarchy-shell varlatch refreshVersion >/dev/null 2>&1 || true; }

# " --ttl <seconds>" from the widget's sessionHours setting; nothing for 0
# or unset, which leaves the length to the server (12 hours by default).
ttl_flag() {
  local hours
  hours=$(widget_setting sessionHours 0)
  if [[ "$hours" =~ ^[0-9]+$ ]] && [ "$hours" -ge 1 ] && [ "$hours" -le 24 ]; then
    echo " --ttl $((hours * 3600))"
  fi
  return 0
}

# Device sign-in (login --start / --wait) arrived in CLI 0.14.0.
device_capable() {
  local v
  v=$(cli_version)
  [ -n "$v" ] && ! version_gt 0.14.0 "$v"
}

host_of() { local h=${1#*://}; echo "${h%%/*}"; }

# The version a server runs, from its anonymous /v1/meta; empty when it
# cannot be read.
server_version() {
  local raw=""
  raw=$(curl -fsS --max-time 10 "$1/v1/meta" 2>/dev/null | jq -r '.serverVersion // empty' 2>/dev/null) || raw=""
  clean_version "$raw" 2>/dev/null || true
}

# For upgrade-cli and install-cli, which run in a terminal.
die() { echo; echo "varlatch: $*" >&2; exit 1; }

need_node() {
  local major
  major=$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo 0)
  [ "$major" -ge 22 ] 2>/dev/null && return 0
  if command -v omarchy >/dev/null 2>&1; then
    die "the CLI of release $1 needs Node.js 22 or newer (found: $(node --version 2>/dev/null || echo none)). Install it with: omarchy install dev-env node"
  fi
  die "the CLI of release $1 needs Node.js 22 or newer (found: $(node --version 2>/dev/null || echo none))."
}

release_base() { echo "https://github.com/$RELEASE_REPO/releases/download/v$1"; }

# The line for exactly file $1 in $2, the text of a SHA256SUMS. Fails unless
# there is one such line.
sums_line() {
  local found
  found=$(grep -E "^[0-9a-f]{64} [ *]${1//./\\.}\$" <<<"$2") || return 1
  [ "$(wc -l <<<"$found")" -eq 1 ] || return 1
  echo "$found"
}

# The CLI release $1 has for this machine, by what its SHA256SUMS (text $2)
# lists: the native program, else the single-file build, which Node.js runs.
release_asset() {
  local arch="" name
  case "$(uname -m)" in
    x86_64 | amd64) arch=amd64 ;;
    aarch64 | arm64) arch=arm64 ;;
  esac
  for name in ${arch:+"varlatch-$1-linux-$arch"} "varlatch-cli-$1.cjs"; do
    if sums_line "$name" "$2" >/dev/null; then echo "$name"; return 0; fi
  done
  return 1
}

# The name of release $1's CLI for this machine.
# Exit status: 0 = asset printed, 1 = release has no CLI for this machine
# (404 or absent from SHA256SUMS), 2 = manifest fetch failed (network/HTTP).
released_cli() {
  local tmp_sums http rc=0 found=""
  tmp_sums=$(mktemp)
  http=$(curl -sSL --max-time 10 -w '%{http_code}' -o "$tmp_sums" "$(release_base "$1")/SHA256SUMS" 2>/dev/null) || rc=$?
  if [ "$rc" -ne 0 ]; then rm -f "$tmp_sums"; return 2; fi
  if [ "$http" = "404" ]; then rm -f "$tmp_sums"; return 1; fi
  if [ "$http" != "200" ]; then rm -f "$tmp_sums"; return 2; fi
  found=$(release_asset "$1" "$(cat "$tmp_sums")") || { rm -f "$tmp_sums"; return 1; }
  rm -f "$tmp_sums"
  printf '%s\n' "$found"
  return 0
}

# Download release $1's CLI for this machine into directory $2 and check it:
# the file's own line in SHA256SUMS, an independent signature check when
# cosign is installed, and the version it reports. For a native release, the
# downloaded program also runs its upstream verify-release bootstrap (which is
# not an independent check). Sets $asset, $expected_hash, and $signature;
# dies before anything is installed.
fetch_release() {
  local version=$1 dir=$2 base got identity cosign_ok=false sum_line
  base=$(release_base "$version")
  echo "Downloading varlatch $version from $RELEASE_REPO..."
  curl -fsSL -o "$dir/SHA256SUMS" "$base/SHA256SUMS" || die "download failed: release $version has no SHA256SUMS."
  asset=$(release_asset "$version" "$(cat "$dir/SHA256SUMS")") \
    || die "release $version has no CLI for this machine ($(uname -m)). Nothing was installed."
  case "$asset" in *.cjs) need_node "$version" ;; esac
  curl -fsSL -o "$dir/$asset" "$base/$asset" || die "download failed: $asset."
  curl -fsSL -o "$dir/SHA256SUMS.sigstore.json" "$base/SHA256SUMS.sigstore.json" 2>/dev/null \
    || rm -f "$dir/SHA256SUMS.sigstore.json"

  identity="https://github.com/$RELEASE_REPO/.github/workflows/release.yml@refs/tags/v$version"
  if [ -f "$dir/SHA256SUMS.sigstore.json" ]; then
    if command -v cosign >/dev/null 2>&1; then
      cosign verify-blob "$dir/SHA256SUMS" --bundle "$dir/SHA256SUMS.sigstore.json" \
        --certificate-identity "$identity" \
        --certificate-oidc-issuer https://token.actions.githubusercontent.com >/dev/null 2>&1 \
        || die "the signature on SHA256SUMS does NOT verify. Nothing was installed."
      cosign_ok=true
      signature="verified with cosign: signed by the $RELEASE_REPO release workflow for v$version"
    else
      signature="NOT checked: the release is signed, but cosign is not installed"
    fi
  else
    signature="none: this release carries no signature"
  fi
  sum_line=$(sums_line "$asset" "$(cat "$dir/SHA256SUMS")") \
    || die "$asset is not listed once in SHA256SUMS. Nothing was installed."
  expected_hash=${sum_line%% *}
  (cd "$dir" && printf '%s\n' "$sum_line" | sha256sum --check --status) \
    || die "$asset does not match SHA256SUMS. Nothing was installed."

  case "$asset" in
    *.cjs) got=$(node "$dir/$asset" --version 2>/dev/null | parse_version) ;;
    *)
      [ -f "$dir/SHA256SUMS.sigstore.json" ] || die "release $version carries no signature. Nothing was installed."
      chmod 700 "$dir/$asset"
      got=$("$dir/$asset" --version 2>/dev/null | parse_version) ;;
  esac
  [ "$got" = "$version" ] || die "the downloaded CLI reports version \"$got\", expected $version. Nothing was installed."
  case "$asset" in
    *.cjs) ;;
    *)
      "$dir/$asset" verify-release --version "$version" --sums "$dir/SHA256SUMS" \
        --bundle "$dir/SHA256SUMS.sigstore.json" --file "$dir/$asset=$asset" >/dev/null \
        || die "the signature on SHA256SUMS does NOT verify. Nothing was installed."
      if [ "$cosign_ok" != true ]; then
        signature="checked by the downloaded binary (install cosign for an independent check)"
      fi ;;
  esac
}

# A Compose installation is on this machine, where the operations guide puts
# it: its host commands stay the TypeScript CLI's, as varlatch-ts.
COMPOSE_DIR="${VARLATCH_COMPOSE_DIR:-/srv/varlatch}"
compose_here() { [ -f "$COMPOSE_DIR/varlatch-install.json" ] || [ -f "$COMPOSE_DIR/docker-compose.yml" ]; }

# The TypeScript CLI at $2 is to be kept as varlatch-ts: the new CLI $1 is
# native, and this machine has a Compose installation.
keeps_typescript() { case "$1" in *.cjs) return 1 ;; esac; is_typescript "$2" && compose_here; }

# Put the checked file $1 at $2, which must report version $3 and have SHA-256
# $4: serialized with flock on a per-target lock file, staged inside the
# destination directory (with sudo only when root-owned and not group/other-
# writable), hashed THERE, launch-tested THERE, re-checked for Homebrew
# immediately before atomic rename over $2, and rolled back by one rename on
# launch failure or INT/TERM/HUP until the new CLI answers at $2.
put_cli() {
  (
    local src=$1 dest=$2 want_version=$3 want_hash=$4
    local dir sudo="" lock_key lock staged old="" keep="" got got_hash
    local published=no verified=no
    dir=$(dirname "$dest")
    if [ ! -w "$dir" ]; then
      if is_root_safe "$dir" && { [ ! -e "$dest" ] || [ -L "$dest" ] || is_root_safe "$dest"; }; then
        sudo="sudo"
        echo "$dir is not writable; using sudo."
      else
        die "$dir is not writable and not a root-owned protected directory; refusing sudo. Install by hand: install -m 755 $(shell_quote "$src") $(shell_quote "$dest")"
      fi
    fi

    mkdir -p "$STATE_DIR"
    lock_key=$(printf '%s/%s' "$(cd "$dir" && pwd -P)" "$(basename "$dest")" | sha256sum | cut -d' ' -f1)
    lock="$STATE_DIR/install-$lock_key.lock"
    exec 9>"$lock"
    flock -n 9 || die "another install or update is running for $dest. Nothing was installed."

    staged="$dir/.varlatch-new.$$"
    cleanup_put() {
      $sudo rm -f "$staged" 2>/dev/null || true
      if [ "$verified" != yes ]; then
        if [ "$published" = yes ]; then
          if [ -n "$old" ] && { [ -e "$old" ] || [ -L "$old" ]; }; then
            if $sudo mv -f "$old" "$dest" 2>/dev/null; then
              echo "varlatch: restored the previous CLI at $dest." >&2
            else
              echo "varlatch: could not restore $dest automatically; backup kept at $old." >&2
            fi
          else
            $sudo rm -f "$dest" 2>/dev/null || true
          fi
        elif [ -n "$old" ]; then
          $sudo rm -f "$old" 2>/dev/null || true
        fi
      fi
    }
    trap cleanup_put EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM

    if is_homebrew "$dest"; then
      die "$dest is installed with Homebrew. Update it with: brew upgrade varlatch"
    fi

    if keeps_typescript "$src" "$dest"; then
      keep="$dir/varlatch-ts"
      if [ -e "$keep" ] && ! is_typescript "$keep"; then
        die "$keep exists and is not the TypeScript CLI; move it away, then run this again. Nothing was installed."
      fi
    fi

    # Copy into the destination directory (root-owned when using sudo), then
    # hash and launch-test THAT staged file before touching $dest.
    $sudo install -m 755 "$src" "$staged" || die "install failed. Nothing was installed."
    got_hash=$(sha256sum "$staged" 2>/dev/null | cut -d' ' -f1)
    [ "$got_hash" = "$want_hash" ] \
      || die "the staged file at $staged does not match SHA256SUMS. Nothing was installed."
    case "$src" in
      *.cjs) got=$(node "$staged" --version 2>/dev/null | parse_version) ;;
      *) got=$("$staged" --version 2>/dev/null | parse_version) ;;
    esac
    [ "$got" = "$want_version" ] \
      || die "the staged CLI does not run (reported \"$got\", expected $want_version). Nothing was installed."

    if [ -e "$dest" ] || [ -L "$dest" ]; then
      old="$dir/.varlatch-old.$$"
      $sudo cp -a "$dest" "$old" || { $sudo rm -f "$old"; old=""; die "install failed. Nothing was installed."; }
    fi

    # Re-check Homebrew immediately before the rename.
    if is_homebrew "$dest"; then
      die "$dest is installed with Homebrew. Update it with: brew upgrade varlatch"
    fi

    $sudo mv -f "$staged" "$dest" || die "install failed."
    published=yes

    got=$("$dest" --version 2>/dev/null | parse_version)
    if [ "$got" != "$want_version" ]; then
      if [ -n "$old" ]; then
        if $sudo mv -f "$old" "$dest"; then
          old=""
          published=no
          die "the new CLI does not run at $dest; the one that was there is back."
        fi
        die "the new CLI does not run at $dest, and the one that was there could not be put back: it is $old."
      fi
      $sudo rm -f "$dest"
      published=no
      die "the new CLI does not run at $dest; it was removed again."
    fi
    verified=yes

    if [ -n "$keep" ]; then
      if $sudo mv -f "$old" "$keep"; then
        echo "Kept the TypeScript CLI as $keep: the Compose installation in $COMPOSE_DIR needs it for its host commands."
      else
        die "installed $dest, but could not move the TypeScript CLI to $keep; backup kept at $old."
      fi
    elif [ -n "$old" ]; then
      $sudo rm -f "$old"
    fi
  )
}

case "${1:-}" in
  has-credentials)
    if show_localhost; then
      status_json | jq -e '.servers | length > 0' >/dev/null
    else
      status_json | jq -e '[.servers[].server | select(test("^[a-z]+://(localhost|127\\.)") | not)] | length > 0' >/dev/null
    fi
    ;;

  status-notify)
    out=$(eval "$CMD status" 2>&1) || { notify "status failed: $out"; exit 1; }
    notify "$out"
    ;;

  verify)
    # The one explicitly network-touching read: --probe checks each stored
    # credential against its server. Only stdout is the document: the CLI
    # can warn on stderr, as on a Node.js release without its security fixes.
    err=$(mktemp)
    # Removed however the action ends. bash skips the EXIT trap when a
    # signal kills it, so those become exits.
    trap 'rm -f "$err"' EXIT
    trap 'exit 129' HUP; trap 'exit 130' INT; trap 'exit 143' TERM
    if ! out=$(eval "$CMD status --probe --json" 2>"$err"); then
      msg=$(cat "$err")
      notify "verify failed: ${msg:-$out}"; exit 1
    fi
    summary=$(echo "$out" | jq -r '.servers[] | "\(.server): \(.probe.state // "unknown")\(if .probe.detail then " (\(.probe.detail))" else "" end)"')
    notify "${summary:-no stored credentials}"
    refresh_widget
    ;;

  login)
    server="${2:-$(login_server)}"
    if [ -z "$server" ]; then
      # No server yet: the panel asks for its address.
      omarchy-shell varlatch connect >/dev/null 2>&1 \
        || notify "No server known. Open the Varlatch panel in the bar to connect to one."
      exit 0
    fi
    # Browser-handoff flow, no terminal: the CLI opens the browser itself
    # and never reads stdin. The pending sign-in (server, fallback URL, pid)
    # goes to $LOGIN_FILE, which the panel watches to offer "open link" /
    # "cancel"; the outcome arrives as a notification.
    mkdir -p "$STATE_DIR"
    if login_running; then
      # One sign-in at a time: a second click re-opens the pending link.
      url=$(jq -r '.url // empty' "$LOGIN_FILE")
      [ -n "$url" ] && xdg-open "$url" >/dev/null 2>&1 &
      exit 0
    fi
    log=$(mktemp)
    trap 'rm -f "$log"; login_idle; refresh_widget' EXIT
    # Own session, so cancel can signal the whole process group.
    setsid bash -c "exec $CMD login --server '$server'$(ttl_flag)" >"$log" 2>&1 </dev/null &
    cli=$!
    write_login() {
      jq -n --arg s "$server" --arg u "$1" --argjson p "$cli" --arg b "$(boot_id)" \
        '{state: "pending", server: $s, url: $u, pid: $p, boot: $b}' | write_state "$LOGIN_FILE"
    }
    write_login ""
    url=""
    while kill -0 "$cli" 2>/dev/null; do
      if [ -z "$url" ]; then
        url=$(grep -m1 -oE 'https?://[^ ]+/enroll\?[^ ]+' "$log" || true)
        [ -n "$url" ] && write_login "$url"
      fi
      sleep 0.3
    done
    rc=0; wait "$cli" || rc=$?
    host=$(host_of "$server")
    if [ "$rc" -eq 0 ]; then
      # Surface a failed revoke of the replaced credential, if any.
      warn=$(grep '^varlatch:' "$log" || true)
      notify "Logged in to $host.${warn:+ $warn}"
    elif [ "$rc" -eq 143 ]; then
      # Quiet when a device sign-in took over.
      jq -e '.replaced == true' "$LOGIN_FILE" >/dev/null 2>&1 || notify "Sign-in to $host cancelled."
    else
      msg="Sign-in to $host failed: $(grep -v '^ ' "$log" | tail -n 2 | tr '\n' ' ')"
      if device_capable; then
        # The notification waits for an answer, so end this sign-in first.
        rm -f "$log"; trap - EXIT; login_idle; refresh_widget
        choice=$(notify-send -a Varlatch -u critical -A "device=Use another device" --wait "Varlatch" "$msg" || true)
        [ "$choice" = "device" ] && exec "$0" login-device "$server"
      else
        notify-send -a Varlatch -u critical "Varlatch" "$msg"
      fi
    fi
    ;;

  login-device)
    # Device sign-in (CLI 0.14.0+): the CLI gets an address and a code, you
    # sign in with your passkey in a browser on any device (a phone works)
    # and approve the code, and `--wait` collects the credential. Like the
    # browser flow, it revokes the credential it replaces only once the new
    # one is saved. The panel shows the address, the code, and a QR code.
    server="${2:-$(login_server)}"
    if [ -z "$server" ]; then
      omarchy-shell varlatch connect >/dev/null 2>&1 \
        || notify "No server known. Open the Varlatch panel in the bar to connect to one."
      exit 0
    fi
    host=$(host_of "$server")
    device_capable || { notify "Signing in from another device needs Varlatch CLI 0.14.0 or newer."; exit 1; }
    mkdir -p "$STATE_DIR"
    # Replaces a browser sign-in still waiting: "other device" on the panel.
    # Wait for its helper to finish, so its cleanup cannot clear ours.
    if login_running; then
      "$0" login-cancel --replace
      for _ in $(seq 1 25); do
        jq -e '.state == "pending"' "$LOGIN_FILE" >/dev/null 2>&1 || break
        sleep 0.2
      done
    fi
    out=$(mktemp); err=$(mktemp); qr=""
    trap 'rm -f "$out" "$err" "$qr"; login_idle; refresh_widget' EXIT
    if ! eval "$CMD login --server '$server' --start --json$(ttl_flag)" >"$out" 2>"$err"; then
      notify-send -a Varlatch -u critical "Varlatch" \
        "Sign-in to $host failed: $(grep -v '^ ' "$err" | tail -n 2 | tr '\n' ' ')"
      exit 1
    fi
    uri=$(jq -r '.verificationUri // empty' "$out" 2>/dev/null || true)
    code=$(jq -r '.userCode // empty' "$out" 2>/dev/null || true)
    expires=$(jq -r '.expiresAt // empty' "$out" 2>/dev/null || true)
    if [ -z "$uri" ] || [ -z "$code" ]; then
      notify-send -a Varlatch -u critical "Varlatch" "Sign-in to $host failed: the CLI gave no address and code."
      exit 1
    fi
    # The address only, for a phone's camera; the code is typed in by hand.
    # Named after the code, so the panel never shows an earlier one.
    qr="$STATE_DIR/device-qr-$code.png"
    if command -v qrencode >/dev/null 2>&1; then
      qrencode -o "$qr" -s 8 -m 2 "$uri" 2>/dev/null || rm -f "$qr"
    fi
    # Own session, so cancel can signal the whole process group.
    setsid "$0" device-wait "$server" >"$out" 2>"$err" </dev/null &
    waiter=$!
    jq -n --arg s "$server" --arg u "$uri" --arg c "$code" --arg e "$expires" \
      --arg q "$([ -f "$qr" ] && echo "$qr")" --argjson p "$waiter" --arg b "$(boot_id)" \
      '{state: "pending", mode: "device", server: $s, url: $u, code: $c, expiresAt: $e,
        qr: $q, pid: $p, boot: $b}' | write_state "$LOGIN_FILE"
    rc=0; wait "$waiter" || rc=$?
    # The CLI prints each --wait answer as indented JSON, and device-wait
    # asks again while the code is pending, so $out holds one or more whole
    # documents: the last one is the answer.
    state=$(jq -rs 'last | .state // empty' "$out" 2>/dev/null || true)
    if [ "$rc" -eq 0 ]; then
      warn=$(grep '^varlatch:' "$err" || true)
      notify "Logged in to $host.${warn:+ $warn}"
    elif [ "$rc" -eq 143 ]; then
      notify "Sign-in to $host cancelled."
    else
      case "$state" in
        denied) msg="Sign-in to $host was denied." ;;
        expired) msg="The sign-in code for $host expired before it was approved." ;;
        *) msg="Sign-in to $host failed: $(grep -v '^ ' "$err" | tail -n 2 | tr '\n' ' ')" ;;
      esac
      notify-send -a Varlatch -u critical "Varlatch" "$msg"
    fi
    ;;

  device-wait)
    # Collect an approved device sign-in. `--wait` gives up at its timeout
    # with 75 while the code is still waiting, so ask again.
    set +e
    while :; do
      eval "$CMD login --server '${2:?server}' --wait --timeout 600 --json"
      rc=$?
      [ "$rc" -eq 75 ] || exit "$rc"
    done
    ;;

  login-cancel)
    # A sign-in whose process is already gone only needs forgetting.
    login_running || { login_idle; exit 0; }
    pid=$(jq -r '.pid' "$LOGIN_FILE")
    # --replace: another sign-in takes over, so the cancelled one stays quiet.
    if [ "${2:-}" = --replace ]; then
      jq '.replaced = true' "$LOGIN_FILE" > "$LOGIN_FILE.tmp" && mv -f "$LOGIN_FILE.tmp" "$LOGIN_FILE"
    fi
    kill -TERM -- "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
    ;;

  login-check)
    # Forget a pending sign-in whose process is gone: killed before it could
    # clean up, or from before a reboot. The widget runs this on each poll
    # while the panel shows a sign-in.
    if jq -e '.state == "pending"' "$LOGIN_FILE" >/dev/null 2>&1 && ! login_running; then
      login_idle
    fi
    ;;

  notify-session)
    # Expiry notification with an action button: "Renew now" while the
    # session is still live (login replaces and revokes the old credential
    # only once the new one is saved), "Log in" once it has expired.
    server="${2:?server}"; state="${3:?state}"; msg="${4:?message}"
    if [ "$state" = "expired" ]; then urgency=critical; label="Log in"
    else urgency=normal; label="Renew now"; fi
    device=(); device_capable && device=(-A "device=Another device")
    choice=$(notify-send -a Varlatch -u "$urgency" -A "login=$label" "${device[@]}" --wait "Varlatch" "$msg" || true)
    case "$choice" in
      login) exec "$0" login "$server" ;;
      device) exec "$0" login-device "$server" ;;
    esac
    ;;

  logout)
    server_flag=""
    [ -n "${2:-}" ] && server_flag=" --server $2"
    out=$(eval "$CMD logout$server_flag" 2>&1) || { notify "$out"; refresh_widget; exit 1; }
    notify "$out"
    refresh_widget
    ;;

  web)
    # A given server's dashboard, else the first stored one.
    server="${2:-$(first_server)}"
    [ -n "$server" ] || { notify "No stored server."; exit 1; }
    xdg-open "$server" >/dev/null 2>&1 &
    ;;

  refresh)
    refresh_widget
    ;;

  plugin-info)
    # The plugin's version and a fingerprint of the code the shell loads
    # (the manifest and the QML), now on disk and as the running shell
    # loaded it. `omarchy plugin update` (or an edit) puts newer code on
    # disk, and the shell does re-create the widget, but from the copy it
    # cached when it started, so only a shell restart loads it. The first
    # call from a shell process (the widget runs this directly, so the
    # shell is the parent) records what it loaded, keyed by that process's
    # id and start time; later calls from it, re-created widgets included,
    # get the same answer. The helper itself runs fresh on every call.
    dir=$(cd "$(dirname "$0")/.." && pwd)
    code=$(cat "$dir/manifest.json" "$dir"/*.qml 2>/dev/null | sha256sum | cut -d' ' -f1)
    version=$(jq -r '.version // empty' "$dir/manifest.json" 2>/dev/null || true)
    started=$(sed -E 's/^.*\) //' "/proc/$PPID/stat" 2>/dev/null | awk '{print $20}' || true)
    key="$(boot_id):$PPID:${started:-0}"
    loaded_file="$STATE_DIR/plugin-loaded.json"
    mkdir -p "$STATE_DIR"
    known="{}"
    [ -f "$loaded_file" ] && known=$(jq -c 'if type == "object" then . else {} end' "$loaded_file" 2>/dev/null || echo "{}")
    # Drop records of shell processes that are gone.
    boot=$(boot_id)
    for k in $(jq -r 'keys[]' <<<"$known"); do
      IFS=: read -r b p s <<<"$k"
      alive=$(sed -E 's/^.*\) //' "/proc/$p/stat" 2>/dev/null | awk '{print $20}' || true)
      if [ "$b" != "$boot" ] || [ "$alive" != "$s" ]; then known=$(jq -c --arg k "$k" 'del(.[$k])' <<<"$known"); fi
    done
    if ! jq -e --arg k "$key" 'has($k)' <<<"$known" >/dev/null; then
      known=$(jq -c --arg k "$key" --arg c "$code" --arg v "$version" '.[$k] = {code: $c, version: $v}' <<<"$known")
    fi
    printf '%s\n' "$known" > "$loaded_file"
    jq -cn --arg v "$version" --arg c "$code" --argjson l "$(jq -c --arg k "$key" '.[$k]' <<<"$known")" \
      '{version: $v, code: $c, loadedVersion: $l.version, loadedCode: $l.code}'
    ;;

  notify-plugin-update)
    # One notification per newer copy, with a button to restart the shell.
    version="${2:-}"
    msg="Varlatch for Omarchy${version:+ $version} is installed. Restart the shell to load it."
    choice=$(notify-send -a Varlatch -A "restart=Restart now" --wait "Varlatch" "$msg" || true)
    [ "$choice" = "restart" ] && exec omarchy restart shell
    ;;

  version-info)
    # One JSON line for the widget: the CLI version, how it is installed,
    # and (checkUpdates on) the latest release, cached in $UPDATE_FILE.
    # `--force` skips the cache; `--max-age <s>` checks again when the last
    # successful check is older than that (the panel passes an hour when it
    # opens; the background default is $UPDATE_TTL).
    force=false; max_age=$UPDATE_TTL
    case "${2:-}" in
      --force) force=true ;;
      --max-age) [[ "${3:-}" =~ ^[0-9]+$ ]] && max_age=$3 ;;
    esac
    current=$(cli_version)
    read -r install install_path <<<"$(cli_install)" || true
    check=$(widget_setting checkUpdates off)
    latest=""; checked=0; attempted=0; notified=""
    if [ -f "$UPDATE_FILE" ]; then
      latest=$(clean_version "$(jq -r '.latest // empty' "$UPDATE_FILE" 2>/dev/null || true)" 2>/dev/null || true)
      checked=$(jq -r '.checkedAt // 0' "$UPDATE_FILE" 2>/dev/null || echo 0)
      attempted=$(jq -r '.attemptedAt // .checkedAt // 0' "$UPDATE_FILE" 2>/dev/null || echo 0)
      notified=$(clean_version "$(jq -r '.notified // empty' "$UPDATE_FILE" 2>/dev/null || true)" 2>/dev/null || true)
    fi
    now=$(date +%s)
    # Stale: older than max_age, or older than the CLI installed here (a
    # release came out, and was installed, since the last check).
    stale=false
    if [ $((now - checked)) -ge "$max_age" ] \
        || { [ -n "$current" ] && [ -n "$latest" ] && version_gt "$current" "$latest"; }; then
      stale=true
    fi
    if [ "$check" = on ] && { $force || { $stale && [ $((now - attempted)) -ge "$UPDATE_MIN_GAP" ]; }; }; then
      attempted=$now
      fetched=$(latest_release)
      if [ -n "$fetched" ]; then latest=$fetched; checked=$now; fi
    fi
    available=false
    if [ "$check" = on ] && [ -n "$current" ] && [ -n "$latest" ] && version_gt "$latest" "$current"; then
      available=true
      if [ "$notified" != "$latest" ]; then
        notified=$latest
        setsid "$0" notify-update "$current" "$latest" "$install" >/dev/null 2>&1 </dev/null &
      fi
    fi
    mkdir -p "$STATE_DIR"
    jq -cn --arg current "$current" --arg install "$install" --arg path "${install_path:-}" \
      --argjson check "$([ "$check" = on ] && echo true || echo false)" \
      --arg latest "$latest" --argjson available "$available" \
      --arg url "$([ -n "$latest" ] && release_url "$latest")" \
      --argjson checked "$checked" --argjson attempted "$attempted" --arg notified "$notified" \
      '{current: $current, install: $install, path: $path, checkUpdates: $check,
        latest: $latest, updateAvailable: $available, releaseUrl: $url,
        checkedAt: $checked, attemptedAt: $attempted, notified: $notified}' | tee "$UPDATE_FILE"
    ;;

  notify-update)
    current="${2:?current}"; latest=$(clean_version "${3:?latest}") || exit 1; install="${4:-}"
    if [ "$install" = release ]; then
      choice=$(notify-send -a Varlatch -A "update=Update" -A "notes=Release notes" --wait "Varlatch" \
        "CLI $latest is available (you have $current)." || true)
    else
      how=""; [ "$install" = homebrew ] && how=" Update it with: brew upgrade varlatch"
      choice=$(notify-send -a Varlatch -A "notes=Release notes" --wait "Varlatch" \
        "CLI $latest is available (you have $current).$how" || true)
    fi
    case "$choice" in
      update) exec omarchy-launch-floating-terminal-with-presentation "$(shell_quote "$0") upgrade-cli $(shell_quote "$latest")" ;;
      notes) xdg-open "$(release_url "$latest")" >/dev/null 2>&1 & ;;
    esac
    ;;

  upgrade-cli)
    # Interactive, in a terminal. A native CLI updates itself, and so does
    # the single-file TypeScript CLI (from 0.11.0) to a release that still
    # has that build: both show what they checked and ask before replacing
    # anything. A release with native programs replaces the TypeScript CLI
    # the way Varlatch's install.sh does, which its self-update cannot.
    set +e
    target="${2:-}"
    if [ -n "$target" ]; then
      target=$(clean_version "$target") || die "invalid version: ${2:-}"
    fi

    read -r install path <<<"$(cli_install)"
    case "$install" in
      release) ;;
      homebrew) die "$path is installed with Homebrew. Update it with: brew upgrade varlatch" ;;
      checkout) die "$path is built from a source checkout. Update it there: git pull, then pnpm install && pnpm build." ;;
      missing) exec "$0" install-cli ;;
      *) die "varlatchCommand is \"$CMD\", which the plugin does not manage. Update it by hand." ;;
    esac

    # self_update <resolved target> [node path for legacy CLI]
    # Elevates only the resolved executable (and resolved node for legacy),
    # and only when each resolved file and its directory are root-owned and
    # not group- or other-writable; otherwise refuses with the manual command.
    self_update() {
      local real=$1 node_bin=${2:-} dir real_dir node_real node_dir rc manual
      real_dir=$(dirname "$real")
      dir=$(dirname "$path")
      if [ -n "$node_bin" ]; then
        # Legacy TypeScript CLI writes beside the invoked path.
        if [ -w "$dir" ]; then
          "$path" self-update ${target:+"$target"}; rc=$?
        else
          node_real=$(readlink -f "$node_bin" 2>/dev/null || echo "$node_bin")
          node_dir=$(dirname "$node_real")
          manual="$(shell_quote "$node_real") $(shell_quote "$real") self-update${target:+ $(shell_quote "$target")}"
          if is_root_safe "$real" && is_root_safe "$real_dir" && is_root_safe "$dir" \
              && is_root_safe "$node_real" && is_root_safe "$node_dir"; then
            echo "$dir is not writable; using sudo."
            sudo "$node_real" "$real" self-update ${target:+"$target"}; rc=$?
          else
            die "refusing to run sudo on $real (target, node, and their directories must be root-owned and not group- or other-writable). Update by hand: $manual"
          fi
        fi
      else
        # Native CLI writes beside the resolved file.
        if [ -w "$real_dir" ]; then
          "$real" self-update ${target:+"$target"}; rc=$?
        else
          manual="$(shell_quote "$real") self-update${target:+ $(shell_quote "$target")}"
          if is_root_safe "$real" && is_root_safe "$real_dir"; then
            echo "$real_dir is not writable; using sudo."
            sudo "$real" self-update ${target:+"$target"}; rc=$?
          else
            die "refusing to run sudo on $real (must be root-owned and not group- or other-writable). Update by hand: $manual"
          fi
        fi
      fi
      "$0" version-info --force >/dev/null 2>&1; refresh_version
      exit $rc
    }
    if is_native "$(readlink -f "$path")"; then self_update "$(readlink -f "$path")"; fi

    current=$(cli_version)
    [ -n "$target" ] || target=$(latest_release)
    [ -n "$target" ] || die "cannot find the latest release of $RELEASE_REPO (offline?)."
    if [ -n "$current" ] && ! version_gt "$target" "$current"; then
      echo "varlatch $current is up to date."; exit 0
    fi
    # (Help captured first: `grep -q` closing the pipe early would fail it
    # under pipefail. sudo may have a PATH without node, so it is named.)
    asset=""; rc=0
    asset=$(released_cli "$target") || rc=$?
    if [ "$rc" -eq 2 ]; then
      die "could not fetch SHA256SUMS for release $target (offline or server error). Nothing was installed."
    elif [ "$rc" -eq 1 ]; then
      die "release $target has no CLI for this machine ($(uname -m)). Nothing was installed."
    fi
    if [ "${asset%.cjs}" != "$asset" ]; then
      help=$("$path" --help 2>&1)
      if [[ "$help" == *self-update* ]]; then self_update "$(readlink -f "$path")" "$(command -v node)"; fi
    fi

    tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
    fetch_release "$target" "$tmp"

    echo
    echo "  varlatch ${current:-?} -> $target"
    echo "  install:   $path"
    echo "  checksum:  ok (SHA256SUMS)"
    echo "  signature: $signature"
    echo "  changes:   $(release_url "$target")"
    echo
    if [ "${asset%.cjs}" = "$asset" ]; then
      echo "  From this release the CLI is a program of its own: it does not need"
      echo "  Node.js. Your sign-ins and settings carry over."
      keeps_typescript "$tmp/$asset" "$path" \
        && echo "  The present CLI is kept beside it as varlatch-ts, for the Compose installation here."
    else
      echo "  Pre-1.0 releases may change the CLI and the /v1 API. If this machine"
      echo "  runs a Varlatch installation, upgrade it first (varlatch upgrade)."
    fi
    echo
    read -rp "Install? [y/N] " answer
    [[ "$answer" =~ ^[yY] ]] || { echo "Nothing installed."; exit 130; }

    put_cli "$tmp/$asset" "$path" "$target" "$expected_hash" || exit $?
    echo "Installed: $(run_cli --version)"
    "$0" version-info --force >/dev/null 2>&1
    refresh_version
    ;;

  install-cli)
    # First run, in a terminal: install the release CLI where the docs put
    # it (~/.local/bin/varlatch), at the version your server runs when you
    # give its address, then offer the first sign-in.
    set +e
    read -r install path <<<"$(cli_install)"
    case "$install" in
      missing) ;;
      release | homebrew) exec "$0" upgrade-cli ;;
      *) echo "varlatch is already installed ($(eval "$CMD --version" 2>/dev/null | head -n1))."; exit 0 ;;
    esac

    echo "Install the Varlatch CLI"
    echo
    echo "  The CLI should match the Varlatch your server runs. Give the server's"
    echo "  address to install that version, or press Enter for the latest release."
    echo
    read -rp "Server address: " answer
    server=$(normalize_server "$answer")
    host=${server#*://}; host=${host%%/*}
    target=""
    if [ -n "$server" ]; then
      target=$(server_version "$server")
      if [ -z "$target" ]; then
        echo "Could not read the version $host runs; using the latest release."
      else
        rc=0; released_cli "$target" >/dev/null || rc=$?
        if [ "$rc" -eq 2 ]; then
          die "could not fetch SHA256SUMS for release $target (offline or server error). Nothing was installed."
        elif [ "$rc" -eq 1 ]; then
          echo "$host runs $target, which has no release CLI; using the latest release."
          echo "If the newer CLI does not work with it, upgrade the server (varlatch upgrade)."
          target=""
        else
          echo "$host runs Varlatch $target."
        fi
      fi
    fi
    [ -n "$target" ] || target=$(latest_release)
    [ -n "$target" ] || die "cannot find the latest release of $RELEASE_REPO (offline?)."

    tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
    fetch_release "$target" "$tmp"
    dest="$HOME/.local/bin/varlatch"

    echo
    echo "  varlatch $target"
    echo "  install:   $dest"
    echo "  checksum:  ok (SHA256SUMS)"
    echo "  signature: $signature"
    echo "  changes:   $(release_url "$target")"
    echo
    read -rp "Install? [y/N] " answer
    [[ "$answer" =~ ^[yY] ]] || { echo "Nothing installed."; exit 130; }

    mkdir -p "$(dirname "$dest")"
    put_cli "$tmp/$asset" "$dest" "$target" "$expected_hash" || exit $?
    echo "Installed: $("$dest" --version | head -n1)"

    # The widget finds the CLI through a login shell's PATH; without
    # ~/.local/bin on it, point the widget at the file instead.
    found=$(bash -lc 'command -v varlatch' 2>/dev/null || true)
    if [ -z "$found" ] || [ "$(readlink -f "$found")" != "$(readlink -f "$dest")" ]; then
      if omarchy bar set varlatch varlatchCommand "$dest" >/dev/null 2>&1; then
        echo "$(dirname "$dest") is not on your PATH, so the widget now runs $dest."
      else
        echo "$(dirname "$dest") is not on your PATH. Point the widget at the CLI:"
        echo "  omarchy bar set varlatch varlatchCommand $dest"
      fi
    fi
    "$0" version-info --force >/dev/null 2>&1; refresh_version; refresh_widget

    [ -n "$server" ] || exit 0
    remember_server "$server"
    echo
    read -rp "Sign in to $host now? [Y/n] " answer
    [[ "$answer" =~ ^[nN] ]] && exit 0
    # Detached, so the sign-in outlives this terminal; the panel shows it.
    setsid "$0" login "$server" >/dev/null 2>&1 </dev/null &
    echo "Your browser opens for the passkey prompt."
    ;;

  sync-menu)
    # `--restart <version>`: the widget saw newer plugin code on disk.
    restart_version=""
    [ "${2:-}" = --restart ] && restart_version="${3:-}"
    # Regenerate this plugin's managed block in omarchy-menu.jsonc from the
    # current session state, so the submenu shows what you are logged in to
    # and offers only the actions that make sense. The menu hot-reloads the
    # file; we only rewrite (and refresh) when the content actually changed.
    # The widget runs this after every status poll, so runs can overlap: one
    # at a time, or two would interleave their writes to the menu file.
    mkdir -p "$STATE_DIR"
    exec 9>"$STATE_DIR/sync-menu.lock"
    flock -w 30 9 || exit 0
    VARLATCH_RESTART_VERSION="$restart_version" VARLATCH_MENU_CMD="$CMD" VARLATCH_SHOW_LOCALHOST="$(show_localhost && echo on || echo off)" python3 - <<'PY'
import json, os, re, shlex, subprocess, sys, tempfile
from datetime import datetime, timezone

def write_atomic(path, text):
    # The shell watches these files and reads them the moment they change,
    # so never let it see one half-written: write a sibling and rename it
    # over. Through a symlink (dotfiles), replace the file it points to.
    path = os.path.realpath(path)
    directory = os.path.dirname(path)
    os.makedirs(directory, exist_ok=True)
    try:
        mode = os.stat(path).st_mode & 0o777
    except FileNotFoundError:
        mode = 0o644
    fd, tmp = tempfile.mkstemp(dir=directory, prefix="." + os.path.basename(path) + ".")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except FileNotFoundError:
            pass
        raise

home = os.path.expanduser("~")
menu_path = os.path.join(home, ".config/omarchy/extensions/omarchy-menu.jsonc")
bin_path = os.path.join(home, ".config/omarchy/plugins/varlatch/bin/varlatch-menu")
cmd = os.environ["VARLATCH_MENU_CMD"]

cli_missing = False
try:
    out = subprocess.run(["bash", "-lc", f"{cmd} status --json"],
                         capture_output=True, text=True, timeout=15)
    # 127: the shell found no such command.
    cli_missing = out.returncode == 127
    doc = json.loads(out.stdout) if out.returncode == 0 else {"servers": []}
except Exception:
    doc = {"servers": []}
servers = doc.get("servers") or []

state_file = os.path.join(home, ".local/state/varlatch-omarchy/servers.json")
def not_local(u): return not re.match(r"^[a-z]+://(localhost|127\.)", str(u))
if os.environ.get("VARLATCH_SHOW_LOCALHOST") != "on":
    servers = [s for s in servers if not_local(s["server"])]

# Remember servers across logouts so "Log in" keeps a target. The widget
# reloads the file on every change, so leave it alone when nothing changed.
if servers:
    known = json.dumps([s["server"] for s in servers])
    try:
        previous = open(state_file, encoding="utf-8").read()
    except OSError:
        previous = None
    if previous != known:
        write_atomic(state_file, known)
remembered = []
try:
    remembered = json.load(open(state_file, encoding="utf-8"))
except Exception:
    pass
if os.environ.get("VARLATCH_SHOW_LOCALHOST") != "on":
    remembered = [u for u in remembered if not_local(u)]
remembered = sorted(remembered, key=lambda u: 0 if not_local(u) else 1)

def host(url):
    return re.sub(r"/.*$", "", re.sub(r"^[a-z]+://", "", str(url)))

def left(s, now):
    exp = s.get("expiresAt")
    if not exp:
        return "no expiry recorded"
    try:
        dt = datetime.fromisoformat(exp.replace("Z", "+00:00"))
    except ValueError:
        return "no expiry recorded"
    seconds = (dt - now).total_seconds()
    if seconds <= 0:
        return "EXPIRED"
    # Whole hours only: every change to this text rewrites the menu file and
    # reloads the menu, and minutes would do that once a minute. The panel
    # keeps the minute countdown.
    h = int(seconds // 3600)
    return f"{h}h left" if h else "under an hour left"

# CLI version and update, from the widget's last version-info.
try:
    ver = json.load(open(os.path.join(home, ".local/state/varlatch-omarchy/update.json"), encoding="utf-8"))
except Exception:
    ver = {}

def at_least(version, want):
    try:
        return tuple(int(x) for x in str(version).split("-")[0].split(".")[:3]) >= want
    except ValueError:
        return False

# Device sign-in (login --start / --wait) arrived in CLI 0.14.0.
device = at_least(ver.get("current") or "", (0, 14, 0))

now = datetime.now(timezone.utc)
expired = [s for s in servers if s.get("expired") is True]
live = [s for s in servers if s.get("expired") is not True]

if cli_missing:
    root_desc = "CLI not installed"
elif not servers:
    root_desc = "Not logged in"
elif len(servers) == 1:
    s = servers[0]
    root_desc = f"{host(s['server'])}, {left(s, now)}"
else:
    root_desc = f"{len(live)}/{len(servers)} sessions live"

entries = [("varlatch", {"icon": "", "label": "Varlatch", "description": root_desc})]
for i, s in enumerate(servers):
    entries.append((f"varlatch.session{i}", {
        "icon": "",
        "label": host(s["server"]),
        "description": "Logged in, " + left(s, now) if s.get("expired") is not True
            else "Session expired, log in again",
        "action": f"{bin_path} status-notify",
    }))
if cli_missing:
    entries.append(("varlatch.install", {"icon": "\uf019", "label": "Install the CLI",
        "description": "Download the release CLI, checked against its checksums",
        "action": f"omarchy-launch-floating-terminal-with-presentation {bin_path} install-cli"}))
elif not servers or expired:
    label = "Log in" if not live else "Log in again"
    target = (expired[0]["server"] if expired
              else servers[0]["server"] if servers
              else remembered[0] if remembered
              else os.environ.get("VARLATCH_SERVER", ""))
    if target:
        entries.append(("varlatch.login", {"icon": "", "label": label,
            "description": "Browser passkey sign-in", "action": f"{bin_path} login {target}"}))
        if device:
            entries.append(("varlatch.device", {"icon": "\uf10b", "label": label + " from another device",
                "description": "Approve with your passkey on any device, such as a phone",
                "action": f"{bin_path} login-device {target}"}))
    else:
        # No server yet: the panel asks for its address.
        entries.append(("varlatch.connect", {"icon": "\uf0c1", "label": "Connect to a server",
            "description": "Give its address in the Varlatch panel",
            "action": "omarchy-shell varlatch connect"}))
# Any live session can be renewed: a login to the same server, which
# revokes the old credential once the new one is saved.
for i, s in enumerate(live):
    entries.append((f"varlatch.renew{i}", {"icon": "\uf021",
        "label": "Renew session" if len(live) == 1 else f"Renew {host(s['server'])}",
        "description": f"{host(s['server'])}, {left(s, now)} · browser passkey sign-in",
        "action": f"{bin_path} login {s['server']}"}))
if servers:
    if len(servers) == 1:
        # Always name the server: the store may hold hidden (localhost)
        # entries the CLI would otherwise ask to disambiguate.
        entries.append(("varlatch.logout", {"icon": "", "label": "Log out",
            "description": "Revoke server-side and remove locally",
            "action": f"{bin_path} logout {servers[0]['server']}"}))
    else:
        for i, s in enumerate(servers):
            entries.append((f"varlatch.logout{i}", {"icon": "",
                "label": f"Log out {host(s['server'])}",
                "action": f"{bin_path} logout {s['server']}"}))
    entries.append(("varlatch.verify", {"icon": "", "label": "Verify credentials",
        "description": "Probe each stored credential against its server",
        "action": f"{bin_path} verify"}))
    # One dashboard row per server: the dashboard is the server itself.
    if len(servers) == 1:
        entries.append(("varlatch.web", {"icon": "", "label": "Open dashboard",
            "action": f"{bin_path} web {servers[0]['server']}"}))
    else:
        for i, s in enumerate(servers):
            entries.append((f"varlatch.web{i}", {"icon": "", "label": f"Open {host(s['server'])}",
                "description": "Dashboard", "action": f"{bin_path} web {s['server']}"}))
latest_ver = str(ver.get("latest") or "")
if (ver.get("updateAvailable") and ver.get("install") == "release"
        and len(latest_ver) <= 64
        and re.fullmatch(r"v?[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.]+)?", latest_ver)):
    entries.append(("varlatch.update", {"icon": "", "label": "Update CLI",
        "description": f"{ver.get('current')} → {latest_ver}",
        "action": f"omarchy-launch-floating-terminal-with-presentation {shlex.quote(bin_path)} upgrade-cli {shlex.quote(latest_ver)}"}))
if os.environ.get("VARLATCH_RESTART_VERSION"):
    entries.append(("varlatch.restart", {"icon": "\uf021",
        "label": "Restart to load Varlatch for Omarchy " + os.environ["VARLATCH_RESTART_VERSION"],
        "description": "Newer widget code is installed; restarts the Omarchy shell",
        "action": "omarchy restart shell"}))
status = {"icon": "", "label": "Show full status", "action": f"{bin_path} status-notify"}
if ver.get("current"):
    status["description"] = f"CLI {ver['current']}"
if not cli_missing:
    entries.append(("varlatch.status", status))

# Every entry ends with a comma, so the block stays valid wherever it sits:
# the menu drops a trailing comma before the closing brace.
body = "\n".join(f'  "{k}": {json.dumps(v, ensure_ascii=False)},' for k, v in entries)
block = ("// >>> varlatch plugin (managed block; regenerated by varlatch-menu sync-menu)\n"
         + body + "\n// <<< varlatch plugin")

def with_block(raw):
    # First run: add the block before the closing brace, after a comma on
    # the last entry when it has none. The menu skips whole-line comments only.
    end = raw.rstrip().rfind("}")
    if end < 0:
        return None
    lines = raw[:end].rstrip().split("\n")
    i = len(lines) - 1
    while i >= 0 and (not lines[i].strip() or lines[i].lstrip().startswith("//")):
        i -= 1
    if i >= 0 and not lines[i].rstrip().endswith(("{", ",")):
        lines[i] = lines[i].rstrip() + ","
    return "\n".join(lines) + "\n\n" + block + "\n" + raw[end:]

try:
    raw = open(menu_path, encoding="utf-8").read()
except FileNotFoundError:
    raw = "{\n}\n"
if re.search(r"// >>> varlatch plugin.*?// <<< varlatch plugin", raw, flags=re.S):
    new = re.sub(r"// >>> varlatch plugin.*?// <<< varlatch plugin", lambda _: block, raw, count=1, flags=re.S)
else:
    new = with_block(raw)
    if new is None:
        sys.exit(f"varlatch-menu: {menu_path} is not a JSONC object; menu entries not added.")
if new == raw:
    sys.exit(0)
write_atomic(menu_path, new)
subprocess.run(["omarchy", "menu", "refresh"], capture_output=True)
PY
    ;;

  *)
    echo "Usage: varlatch-menu <has-credentials|status-notify|verify|notify-session <server> <state> <message>|login [server]|login-device [server]|login-cancel|login-check|logout [server]|web [server]|refresh|plugin-info|notify-plugin-update <version>|sync-menu [--restart <version>]|version-info [--force|--max-age <s>]|notify-update <current> <latest> <install>|upgrade-cli [version]|install-cli>" >&2
    exit 1
    ;;
esac
